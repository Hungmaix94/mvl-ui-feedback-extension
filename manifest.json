{
  "manifest_version": 3,
  "name": "SnapUI — Visual Feedback for QA & FE",
  "version": "2.5.0",
  "description": "Ultra-compact visual feedback tool for QA (Plane / Linear / Jira / GitHub Issues with native image attachments) and Frontend Developers (AI Remote MCP).",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SnapUI (QA Plane / FE MCP)",
    "default_popup": "popup.html"
  },
  "commands": {
    "start-crop-feedback": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Start visual crop & feedback"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["default-config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
